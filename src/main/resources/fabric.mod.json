{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/create",
    "sources": "https://github.com/jackhair/Create",
    "issues": "https://github.com/jackhair/Create/issues"
  },
  "license": "${mod_license}",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.simibubi.create.Create"
    ],
    "client": [
      "com.simibubi.create.CreateClient"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "create_neoforge_shim.mixins.json"
  ],
  "accessWidener": "${mod_id}.accesswidener",
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=21",
    "flywheel": ">=1.0.0 <2.0",
    "ponder": ">=${ponder_version}",
    "forgeconfigapiport": "*"
  },
  "breaks": {
    "sodium": "<0.6.9",
    "lithium": "<0.14.7",
    "radium": "*",
    "palladium": "*"
  },
  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/class_3611": [
        "com/simibubi/create/infrastructure/fabric/neoforged/neoforge/common/extensions/IFluidExtension"
      ],
      "net/minecraft/class_3610": [
        "com/simibubi/create/infrastructure/fabric/neoforged/neoforge/common/extensions/IFluidStateExtension"
      ],
      "net/minecraft/class_1297": [
        "com/simibubi/create/infrastructure/fabric/neoforged/neoforge/attachment/IAttachmentHolder",
        "com/simibubi/create/infrastructure/fabric/neoforged/neoforge/common/extensions/IEntityExtension"
      ],
      "net/minecraft/class_1937": [
        "com/simibubi/create/infrastructure/fabric/neoforged/neoforge/common/extensions/ILevelExtension"
      ],
      "net/minecraft/class_1799": [
        "com/simibubi/create/infrastructure/fabric/neoforged/neoforge/common/extensions/IItemStackExtension"
      ],
      "net/minecraft/class_2586": [
        "com/simibubi/create/infrastructure/fabric/neoforged/neoforge/common/extensions/IBlockEntityExtension"
      ]
    }
  }
}
